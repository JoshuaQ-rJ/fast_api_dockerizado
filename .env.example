# Copia este archivo como .env en la EC2 #2 y cambia los valores.

# Conexión a PostgreSQL (EC2 #3).
#  - El host es la IP PRIVADA de la EC2 #3 (p. ej. 10.0.2.15), nunca una IP pública.
#  - Usuario, contraseña y base deben coincidir con deploy/postgres/.env.
#  - La contraseña debe tener solo letras y números: caracteres como @ : / #
#    rompen el formato de la URL.
Database_url=postgresql://app_user:CambiaEstaClave123@<IP_PRIVADA_EC2_3>:5432/app_db

# Región de AWS del bucket (opcional, por defecto us-east-2)
AWS_REGION=us-east-2

# Bucket privado de S3 donde se guardan las imágenes
S3_BUCKET_NAME=<NOMBRE_DEL_BUCKET>

# No pongas AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY: en la EC2 boto3
# obtiene credenciales temporales del IAM Role asociado a la instancia.
